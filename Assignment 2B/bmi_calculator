weight=float(input("Enter your weight in kg:\n"))
height=float(input("Enter your height in meters:\n"))

category=["Underweight","Normal weight","Overweight","Obese"]

bmi=weight/height**2

if bmi<18.5:
    print(f"Your BMI is {round(bmi,2)}\nCategory: {category[0]}")
elif bmi>=18.5 and bmi<25:
    print(f"Your BMI is {round(bmi,2)}\nCategory: {category[1]}")
elif bmi>=25 and bmi<=30:
    print(f"Your BMI is {round(bmi,2)}\nCategory: {category[2]}")
elif bmi>30:
    print(f"Your BMI is {round(bmi,2)}\nCategory: {category[3]}")
